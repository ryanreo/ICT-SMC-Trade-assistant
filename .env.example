# .env.example
# ==========================================
# API KEYS & SECRETS
# ==========================================

# Gemini AI for Context Engineering & Validation
GEMINI_API_KEY=your_gemini_api_key_here

# MetaTrader 5 (if using remote MT5 server, otherwise local desktop app handles auth)
MT5_LOGIN=your_mt5_account_id
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_broker_server

# CCXT / Crypto Exchange (if targeting crypto)
BINANCE_API_KEY=your_binance_key
BINANCE_SECRET=your_binance_secret

# ==========================================
# TRADING PREFERENCES
# ==========================================
RISK_PER_TRADE_PERCENT=1.0
ATR_STOP_PADDING_MULTIPLIER=1.5
CONFIDENCE_THRESHOLD=80
TRADE_ENVIRONMENT=paper_trading # [paper_trading | live]
